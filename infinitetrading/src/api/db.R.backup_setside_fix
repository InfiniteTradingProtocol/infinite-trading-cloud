deassociateGasWallet = function(wallet, manager) {
    wallet <- trimws(tolower(wallet))
    manager <- trimws(tolower(manager))

    response <- tryCatch({
        con <- db_con()
        table_name <- "associated_gas_wallets"
        query <- sprintf("DELETE FROM %s WHERE wallet = '%s' AND manager = '%s'", 
                         table_name, 
                         gsub("'", "''", wallet), 
                         gsub("'", "''", manager))
        res <- dbSendQuery(con, query)
        dbClearResult(res)
        dbDisconnect(con)
        list(status="success", status_code=200, message="Gas wallet successfully deassociated")
    }, error = function(e) {
        cat("An error occurred deassociating a gas wallet: ", e$message, "\n")
        list(status="fail", status_code=500, message="Internal error deassociating gas wallet")
    })
    return(response)
}

getAssociatedGasWallets = function(manager,noKeys=FALSE) {
  gaswallets <- tryCatch({
    table_name = "associated_gas_wallets"
    con = db_con()

    # Query including encrypted_api_key
    if (noKeys) { query <- sprintf("SELECT wallet FROM %s WHERE manager = '%s'",table_name, gsub("'", "''", manager)) }
    else { query <- sprintf("SELECT wallet, label, encrypted_api_key FROM %s WHERE manager = '%s'",table_name, gsub("'", "''", manager)) }
    res <- dbGetQuery(con, query)
    dbDisconnect(con)

    # Decrypt the API key if any rows returned
    if (nrow(res) > 0 && !noKeys) {
      res$apiKey <- sapply(res$encrypted_api_key, function(x) {
        tryCatch({
          secure_decrypt(x)
        }, error = function(e) {
          cat("Decryption error:", e$message, "\n")
          NA  # return NA if decryption fails
        })
      })
    }

    # Drop encrypted_api_key column for cleaner output
    if (!noKeys) res$encrypted_api_key <- NULL
    res

  }, error = function(e) {
    cat("An error occurred fetching associated gas wallets / error: ", e$message, "\n")
    list(status = "fail", status_code = 500, message = "Internal error listing associated gas wallets")
  })
  print("returning asssociated gas wallets to the frontend")
  #print(gaswallets)
  return(gaswallets)
}

getBots <- function(manager, protocol = "dhedge") {
  # CRITICAL FIX: Use single connection for entire function
  con <- db_con()
  on.exit(dbDisconnect(con), add = TRUE)  # Always disconnect on exit
  
  # Fetch associated gas wallets
  networks = c("base","optimism","arbitrum","polygon")
  gasWallets <- tryCatch({
    getAssociatedGasWallets(manager, noKeys = TRUE)
  }, error = function(e) {
    return(list(status = "fail", status_code = 500, message = paste("Error fetching gas wallets:", e$message)))
  })

  if (!is.data.frame(gasWallets) || nrow(gasWallets) == 0) {
    return(list(status = "success", status_code = 200, data = list()))
  }

  result <- list()

  # Iterate over each gas wallet
  for (i in 1:nrow(gasWallets)) {
    wallet <- gasWallets$wallet[i]

    # For each network, check the pools linked to this wallet
    for (network in networks) {
      table_gas <- paste(network, protocol, "gas_wallets", sep = "_")
      table_sides <- paste(network, protocol, "sides", sep = "_")

      # Check if the tables exist, skip if they don't
      tables_exist <- tryCatch({
        tables <- dbListTables(con)
        (table_gas %in% tables) && (table_sides %in% tables)
      }, error = function(e) {
        FALSE
      })

      if (!tables_exist) {
        next  # Skip this network
      }

      pools <- tryCatch({
        pools_query <- sprintf(
          "SELECT pool FROM %s WHERE wallet = '%s'", # AND is_active = 1",
          table_gas, gsub("'", "''", wallet)
        )
        dbGetQuery(con, pools_query)
      }, error = function(e) {
        return(NULL)  # Skip this network on query failure
      })

      if (is.null(pools) || nrow(pools) == 0) {
        next
      }

      for (p in pools$pool) {
        side_info <- tryCatch({
          sides_query <- sprintf(
            "SELECT pair, side, threshold, max_usd, share, platform, slippage
             FROM %s WHERE pool = '%s'",
            table_sides, gsub("'", "''", p)
          )
          dbGetQuery(con, sides_query)
        }, error = function(e) {
          return(NULL)  # Skip this pool if query fails
        })

        if (!is.null(side_info) && nrow(side_info) > 0) {
          for (j in 1:nrow(side_info)) {
            pool_data <- list(
              pool = p,
              gasWallet = wallet,
              network = network,
              pair = side_info$pair[j],
              side = side_info$side[j],
              threshold = side_info$threshold[j],
              max_usd = side_info$max_usd[j],
              share = side_info$share[j],
              platform = side_info$platform[j],
              slippage = side_info$slippage[j]
            )
            result <- append(result, list(pool_data))
          }
        }
      }
    }
  }
  return(list(status = "success", status_code = 200, bots = result))
}
