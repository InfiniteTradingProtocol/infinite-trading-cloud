getWalletPools <- function(protocol, network, wallet) {
  result <- tryCatch({
    con <- db_con()

    # Build table list
    networks <- if (tolower(network) == "all") {
      c("optimism", "base", "arbitrum", "polygon")
    } else {
      tolower(network)
    }
    
    all_results <- list()

    for (net in networks) {
      table_name <- paste0(net, "_", protocol, "_gas_wallets")
      query <- sprintf(
        "SELECT '%s' AS network, pool, is_active FROM %s WHERE wallet = '%s'",
        net, table_name, wallet
      )

      # Check if table exists to avoid error (optional, remove if not needed)
      tables <- dbListTables(con)
      if (!(table_name %in% tables)) {
        cat(sprintf("Warning: table %s does not exist\n", table_name))
        next
      }

      data <- dbGetQuery(con, query)
      all_results[[net]] <- data
    }

    final_result <- do.call(rbind, all_results)
    rownames(final_result) <- NULL
    dbDisconnect(con)
    
    list(status = "success", status_code = 200, message = final_result)

  }, error = function(e) {
    cat("Error in getWalletPools:", e$message, "\n")
    list(status = "fail", status_code = 500, message = "Internal error getting pools for wallet")
  })
  
  return(result)
}
