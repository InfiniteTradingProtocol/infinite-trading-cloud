update_reports = function(name) {
	time = Sys.time(); cnx = db_con(db='infinitetrading'); table_name = "reports"
	if (!dbExistsTable(cnx,sprintf("%s",table_name))) { dbSendQuery(cnx,sprintf("CREATE TABLE `%s`.`%s` (`name` VARCHAR(255) NOT NULL,`time` VARCHAR(255) NOT NULL,PRIMARY KEY (`name`));",'infinitetrading','reports')) }
