write_probabilities = function(delete_row = FALSE,model,timeframe,old_probability,probability,last_close) {
  # Using infinitetrading pool
  cnx = db_con()
  table_name="model_probabilities_new"
  if (delete_row) {
        query_delete_row = dbSendQuery(cnx,sprintf("DELETE FROM `%s` WHERE %s = '%s' ;",table_name,'model',model))
        dbClearResult(query_delete_row)
        dbDisconnect(cnx)
        return(print(sprintf("You have deleted the row: %s",model)))
  }
 if (!dbExistsTable(cnx,sprintf("%s",table_name))){
        dbSendQuery(cnx,sprintf("CREATE TABLE `%s` (`model` VARCHAR(255) NOT NULL,`timeframe` VARCHAR(255) NOT NULL,`old_probability` FLOAT NOT NULL, `probability` FLOAT NOT NULL,`last_price` FLOAT NOT NULL,PRIMARY KEY (`model`));",table_name))
  }
  send = c()
  send$list = dbListTables(conn = cnx)
  send$fields = dbListFields(conn = cnx,sprintf("%s",table_name))
  query = dbSendQuery(cnx, paste("INSERT INTO `",table_name,"`(`model`,`timeframe`,`old_probability`,`probability`,`last_price`) VALUES ('",model,"',","'",timeframe,"',",old_probability,",",probability,",",last_close,") ON DUPLICATE KEY UPDATE `model`='",model,"', `timeframe`='",timeframe,"', `old_probability` = ",old_probability,", `probability` = ",probability,",`last_price` = ",last_close,";",sep=""),append = FALSE)
  send$query = query
  dbClearResult(query)
  dbDisconnect(cnx)
  return(send)
}
