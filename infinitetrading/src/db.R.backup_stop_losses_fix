push_candles = function(candles,pair,timeframe,exchange) {
        table_name=paste(exchange,pair,timeframe,sep="_")
        table_name = gsub("-","_",table_name)
        unix_time=as.numeric(candles[,1])
        open = sprintf("%.8f", Op(candles))
        close = sprintf("%.8f", Cl(candles))
        high = sprintf("%.8f", Hi(candles))
        low = sprintf("%.8f", Lo(candles))
        volume = sprintf("%.8f", Vo(candles))
        n = nrow(candles)
        print(paste0("Pushing candles to the DB: ",table_name))
        for (i in n:1) {
		write_table(schema="infinitetrading",table=table_name,names=c("id","time","low","high","open","close","volume"),types=c("BIGINT UNSIGNED","BIGINT UNSIGNED",rep("FLOAT",5)),values=c(i,unix_time[i],low[i],high[i],open[i],close[i],volume[i]),primary_key="id",print=FALSE)
        }
}

pull_candles = function(pair,timeframe,exchange) {
