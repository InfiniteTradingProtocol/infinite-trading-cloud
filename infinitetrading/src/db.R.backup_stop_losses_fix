write_stop_losses = function(pair,timeframe,ohlc) {
        con = db_con(); 
	table_name = "crypto_stop_losses"
        stop_name = c("hlrange","hlrange3");
        ohlc = head(ohlc,nrow(ohlc) - 1); close = Cl(ohlc); open = Op(ohlc); hi = Hi(ohlc); low = Lo(ohlc); last_close = last(close); last_high = last(hi); last_low = last(low); last_open = last(open)
        for (i in 1:length(stop_name)) {
                if (stop_name[i] == "hlrange") {
                        range = (hi - low)/hi; usual_range = mean(range) + 1.5*sd(range)
                        upper_price = last_close + usual_range*last_close; lower_price = last_close - last_close*(usual_range)
                }
                else if (stop_name[i] == "hlrange3") {
                        range = (hi - low)/hi; usual_range = mean(range) + 10*sd(range)
                        upper_price = last_low + usual_range*last_low; lower_price = last_high - last_high*(usual_range)
                }
                else if (stop_name[i] == "hlema7") {
                        ema_low = EMA(low, n = 7); ema_low = ema_low[!is.na(ema_low)]; ema_sd_low = sd(low)
                        lower_price = last(ema_low-0.382*ema_sd_low)
                        ema_high = EMA(hi, n = 7); ema_high = ema_high[!is.na(ema_high)]; ema_sd_high = sd(hi)
                        upper_price = last(ema_high+0.382*ema_sd_high)
                }
                name = paste(tolower(pair),tolower(timeframe),tolower(stop_name[i]),sep="_")
                send = c()
                send$list = dbListTables(conn = con)
                send$fields = dbListFields(conn = con,sprintf("%s",table_name))
                query = dbSendQuery(con, paste("INSERT INTO `",table_name,"`(`name`,`upper_price`,`lower_price`) VALUES ('",name,"',",upper_price,",",lower_price,") ON DUPLICATE KEY UPDATE `name`='",name,"', `upper_price` = ",upper_price,", `lower_price` = ",lower_price,";",sep=""),append = FALSE)
                send$query = query
                dbClearResult(query)
                send
        }
	dbDisconnect(con)
}
push_composition <- function(pool, df) {
  conn <- db_con('infinitetrading')
  cursor <- dbSendQuery(conn, paste("CREATE TABLE IF NOT EXISTS `", pool, "` (asset VARCHAR(255) PRIMARY KEY, isDeposit BOOLEAN, assetPair VARCHAR(255), symbol VARCHAR(255), amount FLOAT, price FLOAT)", sep = ""))
  dbClearResult(cursor)
  for (i in 1:nrow(df)) {
    #print("amount"); 
    isDeposit = as.logical(df[i,2]); amount = as.numeric(df[i,5]); price = as.numeric(df[i,6])	
    #print(amount)
    sql <- paste0("INSERT INTO `", pool, "` (`asset`,`isDeposit`,`assetPair`,`symbol`,`amount`,`price`) VALUES ('",df[i,1],"',",isDeposit,",'",df[i,3],"','",df[i,4],"',",amount,",",price,") ON DUPLICATE KEY UPDATE `isDeposit`=",isDeposit,",`amount`=",amount,",`price`=",price,";")
    sql;
    tryCatch({dbSendQuery(conn, sql,append=FALSE)},
	    error = function(e) { 
		    print("error sending query: push_composition")
	    	    discord(msg = "Error sending query (push composition)",channel="#error-logs",db=FALSE)
	    })
  }
  dbDisconnect(conn)
  print(paste0("Composition pushed to the DB for: ",pool))
}
get_composition <- function(pool) {
  conn <- db_con('infinitetrading')
  query <- paste0("SELECT * FROM `", pool, "`")
  df <- dbGetQuery(conn, query)
  dbDisconnect(conn)
  df = as.data.frame(df)
  return(df)
}
set_signals = function(model,buy_threshold,sell_threshold,signal_close,signal) { 
	n = length(buy_threshold)
	model = gsub("-", "_", model)
	model = gsub("\\.","_",model)
	print(paste0("model in set signals: ",model))
	for (i in 1:n) {
		write_table(schema="infinitetrading",table=model,names=c("id","buy_threshold","sell_threshold","signal_close","signal"),types=c("TINYINT UNSIGNED", "FLOAT","FLOAT","FLOAT","BOOLEAN","BOOLEAN"),values=c(i,buy_threshold[i],sell_threshold[i],ifelse(signal_close[i],TRUE,FALSE),ifelse(signal[i],TRUE,FALSE)),primary_key="id")
	}
	print(paste0("signals for: ",model, " pushed into the db"))
}
get_signals = function(model,buy_threshold,sell_threshold,candle_close=FALSE) {
        print(paste0("model in get signals before modification: ",model))
	model = gsub("-", "_",model)
	model = gsub("\\.","_",model)
	print(paste0("model in get signals: ",model))
	signals = read_table(db="infinitetrading",table_name = model)
	print(signals)
        buy_threshold = sprintf("%.2f",buy_threshold)
	sell_threshold = sprintf("%.2f",sell_threshold)
	buy_thresholds = sprintf("%.2f", signals$buy_threshold)
	sell_thresholds = sprintf("%.2f", signals$sell_threshold)
	indx = intersect(which(buy_thresholds == buy_threshold),which(sell_thresholds == sell_threshold))
	signals[,3] = as.numeric(signals[,3])
	if (length(indx) == 0) { discord(msg = paste0("Error: model ",model," doesnt exist or thresholds ",buy_threshold," ",sell_threshold," are not configured"),channel="#error-logs") }
        else { return(as.numeric(ifelse(candle_close,signals[indx,4],signals[indx,5]))) }
	return(-1)
}
