{
  "compilerOptions": {
    "target": "ES2022",  
    "module": "commonjs",
    "declaration": true,
    "rootDir": "./",
    "outDir": "./",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*"],
  "exclude": ["node_modules"]
}

